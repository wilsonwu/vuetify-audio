{
  "name": "vuetify-audio",
  "version": "1.0.0",
  "description": "Audio player component for Vue 3 and Vuetify 4",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/vuetify-audio.js",
  "module": "./dist/vuetify-audio.js",
  "exports": {
    ".": {
      "import": "./dist/vuetify-audio.js",
      "default": "./dist/vuetify-audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonwu/vuetify-audio.git"
  },
  "keywords": [
    "audio",
    "sound",
    "mp3",
    "wav",
    "player",
    "vue",
    "vue.js",
    "vuetify",
    "vuetifyjs"
  ],
  "author": "Wilson Wu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wilsonwu/vuetify-audio/issues"
  },
  "homepage": "https://github.com/wilsonwu/vuetify-audio#readme",
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "music-metadata": "^11.14.0",
    "vite": "^8.2.1",
    "vue": "^3.5.41",
    "vuetify": "^4.1.8",
    "wavesurfer.js": "^7.12.11"
  }
}
